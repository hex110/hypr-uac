#%PAM-1.0

# UAC-style consent prompt.
#
# Line 1: "Yes" in the dialog authenticates and the stack is done -- no
# password. Line 2: an explicit "No" fails immediately instead of falling
# through to the password stack.
#
# If the dialog cannot be shown at all -- tty, ssh, no Wayland session,
# toolkit failure -- both lines are ignored and the password stack below runs
# exactly as it did before. That is what makes this unable to lock you out.
auth		[success=done default=ignore]	pam_exec.so quiet /usr/local/bin/hypr-uac-pam prompt
auth		[success=die default=ignore]	pam_exec.so quiet /usr/local/bin/hypr-uac-pam denied

auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
